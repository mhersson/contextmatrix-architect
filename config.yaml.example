# contextmatrix-architect server configuration.
#
# The architect holds no secret but api_key, the HMAC key shared with
# ContextMatrix's backends.architect entry. The LLM endpoint, MCP key and git
# credentials arrive from ContextMatrix on every session start.
#
# Every key can be overridden by CONTEXTMATRIX_ARCHITECT_<KEY>, with __ for a
# nested key (CONTEXTMATRIX_ARCHITECT_MODELS__<persona>).

# Shared HMAC key; must equal backends.architect.api_key in ContextMatrix.
# Required. Env: CONTEXTMATRIX_ARCHITECT_API_KEY
api_key: ""

# Base URL of the ContextMatrix instance. Required.
# Env: CONTEXTMATRIX_ARCHITECT_CONTEXTMATRIX_URL
contextmatrix_url: "http://localhost:8080"

# Log level: debug, info, warn or error. Default: info.
# Env: CONTEXTMATRIX_ARCHITECT_LOG_LEVEL
log_level: info

# Cost cap per stage run, in USD. Default: 5. Stages run capable models over
# real code, so a small cap starves them; raise it per deployment when a stage
# keeps hitting it.
# Runs are priced from their tokens at the price CM sends per session, so this
# binds on every endpoint and a run is stopped within one model call of passing
# it. A model CM cannot price counts only the cost the endpoint reports, and
# max_turns still bounds every run. CM prices only the session model, so a
# persona overridden in models runs unpriced.
# Env: CONTEXTMATRIX_ARCHITECT_MAX_RUN_COST_USD
max_run_cost_usd: 5

# Turn cap per stage run. Default: 80. Grounding and decomposition read many
# files, one tool call per turn. The cost cap bounds spend when the run's model
# is priced; otherwise this does.
# Env: CONTEXTMATRIX_ARCHITECT_MAX_TURNS
max_turns: 80

# Size of the message de-duplication cache. Default: 1000.
# Env: CONTEXTMATRIX_ARCHITECT_MESSAGE_DEDUP_CACHE_SIZE
message_dedup_cache_size: 1000

# Seconds a message id is remembered for de-duplication. Default: 600.
# Env: CONTEXTMATRIX_ARCHITECT_MESSAGE_DEDUP_TTL_SECONDS
message_dedup_ttl_seconds: 600

# Per-persona model overrides (slugs only); the session's model is the default
# for every persona not listed. Default: none.
# Env: CONTEXTMATRIX_ARCHITECT_MODELS__<persona>
models: {}

# Pipeline pack directory; empty uses the pack embedded in the binary.
# Default: empty. Env: CONTEXTMATRIX_ARCHITECT_PACK
pack: ""

# Listen port. Default: 9095. Env: CONTEXTMATRIX_ARCHITECT_PORT
port: 9095

# Directory holding architect.db. Must be writable. Default as below.
# Env: CONTEXTMATRIX_ARCHITECT_STATE_DIR
state_dir: /var/lib/contextmatrix-architect

# Size of the webhook replay cache. Default: 10000.
# Env: CONTEXTMATRIX_ARCHITECT_WEBHOOK_REPLAY_CACHE_SIZE
webhook_replay_cache_size: 10000

# Accepted clock skew on signed webhooks, in seconds. Default: 330.
# Env: CONTEXTMATRIX_ARCHITECT_WEBHOOK_REPLAY_SKEW_SECONDS
webhook_replay_skew_seconds: 330

# Days a blueprint's code checkout is kept after it was last written; mirrors
# are kept. Default: 7. Env: CONTEXTMATRIX_ARCHITECT_WORKSPACE_MAX_AGE_DAYS
workspace_max_age_days: 7
